NODE_ENV=development
PORT=3000

# API process: DB login inheriting app_api only.
DATABASE_URL=postgresql://api_dian_dev:change-me@localhost:5432/api_dian
DATABASE_POOL_MAX=5

# Secret >=32 chars. Production: secret manager, never Git.
AUTH_PEPPER=change-me-use-a-random-secret-at-least-32-chars

# Worker process: use a different DB login inheriting app_worker only.
# Start with: DATABASE_URL="$WORKER_DATABASE_URL" npm run start:worker
WORKER_DATABASE_URL=postgresql://api_dian_worker_dev:change-me@localhost:5432/api_dian
WORKER_ID=worker-local-1
WORKER_LEASE_SECONDS=30
WORKER_MUTATION_PAUSE_SECONDS=5
WORKER_RECONCILE_RETRY_SECONDS=5
WORKER_RECONCILE_MAX_ATTEMPTS=5
WORKER_IDLE_MS=250

# F6B only. The fake worker refuses to boot in production.
FAKE_PROVIDER_SCENARIO=ACCEPT
